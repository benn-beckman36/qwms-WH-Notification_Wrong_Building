  <wsdl:portType name="SendMailServiceSoap">
    <wsdl:operation name="SendMailNotice">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">发送邮件方法 返回bool&lt;/br&gt;
            输入参数：&lt;/br&gt;
            Site:公司别(QSMC/CSMC等)&lt;/br&gt;
            TeamPwd:Team密码&lt;/br&gt;
            From:发件人(工号或邮件地址，可以放空使用默认发件人Web_Notice@quantacn.com发送)&lt;/br&gt;
            To:收件人(工号或邮件地址，多个用户用分号分隔)&lt;/br&gt;
            Cc:抄送人&lt;/br&gt;
            Bcc:密抄人&lt;/br&gt;
            Subject:邮件主题&lt;/br&gt;
            Body:邮件正文&lt;/br&gt;
            IsBodyHtml:是否使用Html格式&lt;/br&gt;
            Attachments:附件地址(共享的绝对路径，多个附件以分号分隔，调用发邮件方法之前请先将附件统一上传至\\quantacn.com\oafs\OA_MailAttachment)&lt;/br&gt;
            UserName:Smtp登录帐号(可以放空使用默认帐号)&lt;/br&gt;
            Password:Smtp登录帐号(可以放空使用默认帐号)&lt;/br&gt;
            LogID:记录的日志ID&lt;/br&gt;
            ErrorMessage:失败的提示信息</wsdl:documentation>
      <wsdl:input message="tns:SendMailNoticeSoapIn" />
      <wsdl:output message="tns:SendMailNoticeSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="SendMail">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">发送邮件方法 返回bool&lt;/br&gt;
            输入参数：&lt;/br&gt;
            TeamPwd:Team密码&lt;/br&gt;
            From:发件人(工号或邮件地址，可以放空使用默认发件人Web_Notice@quantacn.com发送)&lt;/br&gt;
            To:收件人(工号或邮件地址，多个用户用分号分隔)&lt;/br&gt;
            Cc:抄送人&lt;/br&gt;
            Bcc:密抄人&lt;/br&gt;
            Subject:邮件主题&lt;/br&gt;
            Body:邮件正文&lt;/br&gt;
            IsBodyHtml:是否使用Html格式&lt;/br&gt;
            Attachments:附件地址(共享的绝对路径，多个附件以分号分隔，调用发邮件方法之前最好先将附件统一上传至\\quantacn.com\oafs\OA_MailAttachment可提高邮件的发送速度)&lt;/br&gt;
            Mgs:邮件发送的日志ID或者错误提示信息</wsdl:documentation>
      <wsdl:input message="tns:SendMailSoapIn" />
      <wsdl:output message="tns:SendMailSoapOut" />
    </wsdl:operation>
